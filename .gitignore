backend/cache/
backend/generated_maps/
cache/
fastf1_cache/
.fastf1/
*.pkl
*.parquet
*.sqlite3

# 4. Python Build & Runtime Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/

# 5. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 6. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. System & Editor Files
.vscode/
